import Sphincs.H0PTab.Nu0
import Sphincs.H0PTab.Nu1
import Sphincs.H0PTab.P1
import Sphincs.H0PTab.P2_0
import Sphincs.H0PTab.P2_1

/-! **The per-tree moment tables, checked by the kernel.** Upper bounds of `Ψ1(n)` and `Ψ2(n)` for
`n ≤ 150` (generated by `scripts/forest_table.py`). The kernel checks each stage of `H0MomCert.lean`
once, in a module of its own under `H0PTab/` (`H0MomTabs.lean`): `μL` (`Mu`), `hL` (`H`), `νL` in two
ranges of rows (`Nu0`, `Nu1`), `gL` (`G`), and the tables from the stages' literals, `P1tab` (`P1`) and
`P2tab` in two ranges of rows (`P2_0`, `P2_1`). This module joins them. -/

namespace SphincsLayered.Security.H0

theorem νL_eq : νL = νTab := by
  unfold νL
  rw [νQ_eq_of, hL_eq]
  exact map_range_chunks _ _ 107 44 νTab_rows_0 νTab_rows_1

theorem gL_eq : gL = gTab := by
  unfold gL
  rw [gQ_eq_of, μL_eq]
  exact gTab_ofTab

theorem P1tab_eq : (List.range 151).map P1Q = P1tab := by
  rw [P1Q_eq_of, μL_eq]
  exact P1tab_ofTab

theorem P2tab_eq : (List.range 151).map P2Q = P2tab := by
  rw [P2Q_eq_of, νL_eq, gL_eq]
  exact map_range_chunks _ _ 107 44 P2tab_rows_0 P2tab_rows_1

theorem Ψ1R_le_tab (n : ℕ) (hn : n ≤ 150) : Ψ1R n ≤ (P1tab.getD n 0 : ℝ) := by
  rw [← P1tab_eq, getD_map_range P1Q 0 151 n (by omega)]
  exact Ψ1R_le n hn

theorem Ψ2R_le_tab (n : ℕ) (hn : n ≤ 150) : Ψ2R n ≤ (P2tab.getD n 0 : ℝ) := by
  rw [← P2tab_eq, getD_map_range P2Q 0 151 n (by omega)]
  exact Ψ2R_le n hn

end SphincsLayered.Security.H0
