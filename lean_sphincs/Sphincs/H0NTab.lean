import Sphincs.H0NTab.PH
import Sphincs.H0NearMom

/-! **The half-cover moment table, checked by the kernel.** Upper bounds of `ΨH(n)` for `n ≤ 150`
(generated by `scripts/forest_table.py`), checked in `H0NTab/PH.lean` from the literal stage `μTab`
(`H0MomTabs.lean`). -/

namespace SphincsLayered.Security.H0

open SphincsFors.Security.H0

set_option maxRecDepth 1000000

/-- The bound of `ΨH(n)`. -/
def PHQ (n : ℕ) : ℚ :=
  rup (((List.range (n + 1)).map fun i => binQ n i (1 / 16) (15 / 16) * μL.getD i 0).sum) 128

/-- **The half-cover moment bound.** -/
theorem ΨHR_le (j : SubIdx) (n : ℕ) (hn : n ≤ 150) : ΨHR j n ≤ (PHQ n : ℝ) := by
  rw [ΨHR_eq]
  unfold PHQ
  refine rup_ge_real ?_ 128
  rw [list_sum_range]
  push_cast
  refine Finset.sum_le_sum fun i hi => ?_
  have hi' := Finset.mem_range.1 hi
  rw [binQ_cast, μL_getD i (by omega)]
  push_cast
  have h1 := μR_bounds i
  gcongr
  exact h1.2

theorem ΨHR_nonneg (j : SubIdx) (n : ℕ) : 0 ≤ ΨHR j n := avgNR_nonneg (coverHAvg_nonneg j) n 0

theorem PHQ_eq_of : PHQ = PHQOf μL := rfl

theorem PHtab_eq : (List.range 151).map PHQ = PHtab := by
  rw [PHQ_eq_of, μL_eq]
  exact PHtab_ofTab

theorem ΨHR_le_tab (j : SubIdx) (n : ℕ) (hn : n ≤ 150) : ΨHR j n ≤ (PHtab.getD n 0 : ℝ) := by
  rw [← PHtab_eq, getD_map_range PHQ 0 151 n (by omega)]
  exact ΨHR_le j n hn

end SphincsLayered.Security.H0
