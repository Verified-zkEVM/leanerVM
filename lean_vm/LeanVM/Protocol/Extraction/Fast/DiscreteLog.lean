/-
  LeanVM.Protocol.Extraction.Fast.DiscreteLog

  The discrete logarithm to base `g` in `K^×`, computable and cheap: Pohlig–Hellman over the
  seven prime factors of `2^64 - 1`, baby-step giant-step in each subgroup, the Chinese remainder
  theorem, and a final check.
-/

module

public import LeanVM.Parameters.PohligHellman
public import LeanVM.Parameters.Generator
public import LeanVM.Protocol.Extraction.Fast.Address
import all LeanVM.Protocol.Extraction.Fast.Address

/-!
# The discrete logarithm in `K^×`

`g` generates `K^×` (`orderOf_g`: its order is `2^64 - 1 = 3·5·17·257·641·65537·6700417`), so
every nonzero `x : K` is `g^n` for exactly one `n < 2^64 - 1`. `discreteLog x` finds it:

* for each prime `p`, `x^((2^64-1)/p)` is `b^n` in the subgroup of order `p` generated by
  `b = g^((2^64-1)/p)` (`phBase…`, literals checked in `Parameters/PohligHellman.lean`), and
  baby-step giant-step (`bsgs`: the baby steps `(lane of b^j, j)`, `j < s`, sorted by lane, then
  the giant steps `x^((2^64-1)/p) · (b^-s)^k`, `k < s`, each looked up by binary search,
  `findLane` of `Fast/Address.lean`) reads `n mod p` (`phResidue`);
* the seven residues give `n` by the Chinese remainder theorem (`crtCombine`, idempotents
  `e_p ≡ 1 mod p`, `≡ 0` modulo the other primes);
* `discreteLog` returns `n` when `g^n = x` (`logCheck`) and `none` otherwise, so it is sound
  whatever the searches found.

**`discreteLog_spec`** (the decoder's `DiscreteLogSpec`): `discreteLog x = some n ↔ gpow n = x ∧
n < 2^64 - 1`; so `discreteLog_sound`, `discreteLog_complete`, `discreteLog_gpow`
(`discreteLog (g^n) = some (n % (2^64-1))`) and `discreteLog_zero`.

Price on the cost machine (`cost_compile`, measured): about `2.7·10^6` to `5·10^6` per call, most of
it the baby steps of `p = 6700417` (`2589` products, a merge sort) and its giant steps (up to
`2589` products and binary searches); `5` at `x = 0`.

Everything is structural recursion on `ℕ`, `K` products, lanes, a merge sort and a binary search:
no `Nat.find`, no classical choice.
-/

namespace LeanVM.Extraction.Fast

open LeanVM.Parameters

public section

/-! ## Baby-step giant-step in a subgroup -/

/-- The pairs `(lane of b^j, j)` for the `n` indices `j` from `j₀`, where `y = b^j₀`
(`powPairs` of `Fast/Address.lean`, for any base). -/
@[expose] def powPairsBy (b : K) : ℕ → ℕ → K → List (ℕ × ℕ)
  | 0, _, _ => []
  | n + 1, j, y => (y.lane.toNat, j) :: powPairsBy b n (j + 1) (y * b)

/-- **The baby steps** `b^j`, `j < s`: the pairs `(lane of b^j, j)` sorted by lane, read by binary
search (`findLane`). -/
@[expose] def babyTable (b : K) (s : ℕ) : Array (ℕ × ℕ) :=
  ((powPairsBy b s 0 1).mergeSort fun u v ↦ decide (u.1 ≤ v.1)).toArray

/-- The baby step `j` with the lane of `y`, if any. -/
@[expose] def babyLookup (T : Array (ℕ × ℕ)) (y : K) : Option ℕ := findLane T y.lane.toNat 0 T.size

/-- The giant steps: at step `k`, with `y = h · c^k`, a baby step `b^j = y` gives `j + s·k`;
`n` steps more. -/
@[expose] def giantSteps (T : Array (ℕ × ℕ)) (c : K) (s : ℕ) : ℕ → ℕ → K → Option ℕ
  | 0, _, _ => none
  | n + 1, k, y =>
    match babyLookup T y with
    | some j => some (j + s * k)
    | none => giantSteps T c s n (k + 1) (y * c)

/-- **Baby-step giant-step**: an `r` with `b^r = h`, when `c = b^-s` and `h = b^d`, `d < s²`. -/
@[expose] def bsgs (b c : K) (s : ℕ) (h : K) : Option ℕ := giantSteps (babyTable b s) c s s 0 h

/-- The residue modulo `p` of the exponent of `x`, `q = (2^64-1)/p`, `b = g^q`, `c = b^(p-s)`
(`0` at `x = 0`, which has none: the test comes first, see `discreteLog`). -/
@[expose] def phResidue (q p s : ℕ) (b c : K) (x : K) : ℕ :=
  if x = 0 then 0 else (bsgs b c s (x ^ q)).getD 0 % p

/-- The Chinese remainder theorem for `2^64 - 1`: the `n < 2^64 - 1` with the seven residues
`r3, …, r6700417`. -/
@[expose] def crtCombine (r3 r5 r17 r257 r641 r65537 r6700417 : ℕ) : ℕ :=
  (12297829382473034410 * r3 + 7378697629483820646 * r5 + 1085102592571150095 * r17 +
    2296870857426870240 * r257 + 16979062407938588850 * r641 +
    4611615650756935680 * r65537 + 10691053700478254925 * r6700417) % 18446744073709551615

/-- The candidate exponent of `x`: its seven residues combined. -/
@[expose] def phCandidate (x : K) : ℕ :=
  crtCombine
    (phResidue 6148914691236517205 3 2 phBase3 phStride3 x)
    (phResidue 3689348814741910323 5 3 phBase5 phStride5 x)
    (phResidue 1085102592571150095 17 5 phBase17 phStride17 x)
    (phResidue 71777214294589695 257 17 phBase257 phStride257 x)
    (phResidue 28778071877862015 641 26 phBase641 phStride641 x)
    (phResidue 281470681808895 65537 257 phBase65537 phStride65537 x)
    (phResidue 2753074036095 6700417 2589 phBase6700417 phStride6700417 x)

/-- `some n` when `g^n = x`. -/
@[expose] def logCheck (x : K) (n : ℕ) : Option ℕ := if g ^ n = x then some n else none

/-- **The discrete logarithm to base `g`**: `some n` with `n < 2^64 - 1` and `g^n = x`, `none`
when there is none (`x = 0`).

The candidate is checked in a function of its own (`logCheck`), so the cost compiler prices the
check on its argument. The test `x = 0` comes first (here and in `phResidue`) so that reducing
`discreteLog x` on an unknown `x` stops at once: past it, the kernel would evaluate the closed
baby-step tables (`babyTable phBase6700417 2589`: `2589` nested insertions) and fail on its
recursion depth, whenever a proof makes it reduce a `match` on `discreteLog x`. -/
@[expose] def discreteLog (x : K) : Option ℕ := if x = 0 then none else logCheck x (phCandidate x)

/-! ## The baby steps -/

theorem lane_inj {a b : K} (h : a.lane.toNat = b.lane.toNat) : a = b :=
  BF64.toBitVec_injective (congrArg UInt64.toBitVec (UInt64.toNat_inj.1 h))

theorem mem_powPairsBy (b : K) (k v : ℕ) :
    ∀ (n j : ℕ), (k, v) ∈ powPairsBy b n j (b ^ j) ↔ j ≤ v ∧ v < j + n ∧ k = (b ^ v).lane.toNat
  | 0, j => by simp [powPairsBy]; omega
  | n + 1, j => by
    rw [powPairsBy, ← pow_succ, List.mem_cons, mem_powPairsBy b k v n (j + 1), Prod.mk.injEq]
    constructor
    · rintro (⟨h₁, rfl⟩ | ⟨h₁, h₂, h₃⟩)
      · exact ⟨le_rfl, by omega, h₁⟩
      · exact ⟨by omega, by omega, h₃⟩
    · rintro ⟨h₁, h₂, h₃⟩
      rcases h₁.lt_or_eq with h₁ | rfl
      · exact .inr ⟨h₁, by omega, h₃⟩
      · exact .inl ⟨h₃, rfl⟩

theorem mem_babyTable (b : K) (s k v : ℕ) :
    (k, v) ∈ (babyTable b s).toList ↔ v < s ∧ k = (b ^ v).lane.toNat := by
  rw [babyTable, List.toList_toArray, List.mem_mergeSort, show (1 : K) = b ^ 0 from (pow_zero b).symm,
    mem_powPairsBy]
  simp only [Nat.zero_le, true_and, Nat.zero_add]

theorem sortedLanes_babyTable (b : K) (s : ℕ) : SortedLanes (babyTable b s) := by
  set l := (powPairsBy b s 0 1).mergeSort fun u v : ℕ × ℕ ↦ decide (u.1 ≤ v.1) with hl
  have hp : l.Pairwise fun u v ↦ decide (u.1 ≤ v.1) = true :=
    List.pairwise_mergeSort (fun u v w h₁ h₂ ↦ by simp only [decide_eq_true_eq] at *; omega)
      (fun u v ↦ by simp only [Bool.or_eq_true, decide_eq_true_eq]; omega) _
  have hsize : (babyTable b s).size = l.length := by simp [babyTable, hl]
  have hget : ∀ m (hm : m < l.length), (babyTable b s).getD m (0, 0) = l[m] := by
    intro m hm
    simp [babyTable, ← hl, Array.getD_eq_getD_getElem?, List.getElem?_eq_getElem hm]
  intro i j hij hj
  rw [hsize] at hj
  rw [hget i (by omega), hget j hj]
  rcases hij.lt_or_eq with hij | rfl
  · simpa using List.pairwise_iff_getElem.1 hp i j (by omega) hj hij
  · exact le_rfl

/-- A baby step found is an exponent of `y`. -/
theorem babyTable_sound (b : K) (s : ℕ) {y : K} {v : ℕ}
    (h : babyLookup (babyTable b s) y = some v) : b ^ v = y :=
  lane_inj ((mem_babyTable b s _ v).1
    (findLane_sound _ _ _ 0 _ rfl (Nat.le_refl _) h)).2.symm

/-- Every power `b^i`, `i < s`, is among the baby steps. -/
theorem babyTable_complete (b : K) (s : ℕ) {i : ℕ} (hi : i < s) :
    (babyLookup (babyTable b s) (b ^ i)).isSome := by
  have hm : ((b ^ i).lane.toNat, i) ∈ (babyTable b s).toList := (mem_babyTable b s _ i).2 ⟨hi, rfl⟩
  obtain ⟨idx, hidx, he⟩ := List.getElem_of_mem hm
  have hidx' : idx < (babyTable b s).size := by simpa using hidx
  refine findLane_complete _ (sortedLanes_babyTable b s) _ _ 0 _ rfl (Nat.le_refl _)
    (Nat.zero_le idx) hidx' ?_
  simp only [Array.getD_eq_getD_getElem?, Array.getElem?_eq_getElem hidx', Option.getD_some]
  rw [← Array.getElem_toList (h := hidx'), he]

/-! ## The giant steps -/

/-- What the giant steps find is an exponent of `h`. -/
theorem giantSteps_sound {b c h : K} {s : ℕ} (hc : b ^ s * c = 1) :
    ∀ (n k : ℕ) (y : K) {r : ℕ}, y * (b ^ s) ^ k = h →
      giantSteps (babyTable b s) c s n k y = some r → b ^ r = h := by
  intro n
  induction n with
  | zero => intro k y r _ hr; simp [giantSteps] at hr
  | succ n ih =>
    intro k y r hy hr
    simp only [giantSteps] at hr
    split at hr
    · rename_i j hj
      obtain rfl := Option.some.inj hr
      rw [pow_add, pow_mul, babyTable_sound b s hj, hy]
    · refine ih (k + 1) (y * c) (by rw [← hy, pow_succ]; linear_combination (y * (b ^ s) ^ k) * hc)
        hr

/-- The giant steps find an exponent of `b^d`, `d = s·k₀ + j₀`, `j₀ < s`, when step `k₀` is
among them. -/
theorem giantSteps_complete {b c : K} {s d : ℕ} (hs : 0 < s) (hc : b ^ s * c = 1) :
    ∀ (n k : ℕ) (y : K), y * (b ^ s) ^ k = b ^ d → k ≤ d / s → d / s < k + n →
      (giantSteps (babyTable b s) c s n k y).isSome := by
  have hbs : b ^ s ≠ 0 := left_ne_zero_of_mul_eq_one hc
  intro n
  induction n with
  | zero => intro k y _ h1 h2; omega
  | succ n ih =>
    intro k y hy h1 h2
    simp only [giantSteps]
    split
    · rfl
    · rename_i hnone
      by_cases hk : d / s = k
      · exfalso
        have hyj : y = b ^ (d % s) := by
          refine mul_right_cancel₀ (pow_ne_zero k hbs) ?_
          rw [hy, ← pow_mul, ← pow_add, ← hk, Nat.mod_add_div d s]
        have := babyTable_complete b s (Nat.mod_lt d hs)
        rw [← hyj, hnone] at this
        exact absurd this (by simp)
      · exact ih (k + 1) (y * c)
          (by rw [← hy, pow_succ]; linear_combination (y * (b ^ s) ^ k) * hc) (by omega) (by omega)

theorem bsgs_sound {b c h : K} {s r : ℕ} (hc : b ^ s * c = 1) (hr : bsgs b c s h = some r) :
    b ^ r = h :=
  giantSteps_sound hc s 0 h (by simp) hr

theorem bsgs_complete {b c : K} {s d : ℕ} (hc : b ^ s * c = 1) (hd : d < s * s) :
    (bsgs b c s (b ^ d)).isSome := by
  have hs : 0 < s := Nat.pos_of_ne_zero fun h ↦ by simp [h] at hd
  exact giantSteps_complete (d := d) hs hc s 0 _ (by simp) (Nat.zero_le _) (by
    rw [Nat.div_lt_iff_lt_mul hs]
    simpa using hd)

/-! ## A residue -/

/-- **The residue modulo `p`** of the exponent of `g^m` is `m % p`, for `q·p = 2^64 - 1`,
`b = g^q`, `b^s·c = 1` and `p ≤ s²`. -/
theorem phResidue_gpow {q p s : ℕ} {b c : K} (hb : b = g ^ q) (hqp : q * p = 2 ^ 64 - 1)
    (hc : b ^ s * c = 1) (hs : p ≤ s * s) (m : ℕ) : phResidue q p s b c (g ^ m) = m % p := by
  have hq : q ≠ 0 := by rintro rfl; simp at hqp
  have hp : 0 < p := by rcases Nat.eq_zero_or_pos p with h | h <;> simp_all
  have hob : orderOf b = p := by
    rw [hb, orderOf_pow_of_dvd hq (by rw [orderOf_g]; exact ⟨p, hqp.symm⟩), orderOf_g, ← hqp,
      Nat.mul_div_cancel_left _ (Nat.pos_of_ne_zero hq)]
  have hx : (g ^ m) ^ q = b ^ (m % p) := by
    rw [← pow_mul, mul_comm, pow_mul, ← hb, ← hob, pow_mod_orderOf]
  obtain ⟨r, hr⟩ := Option.isSome_iff_exists.1
    (bsgs_complete hc (lt_of_lt_of_le (Nat.mod_lt m hp) hs) : (bsgs b c s (b ^ (m % p))).isSome)
  have hbr := bsgs_sound hc hr
  simp only [phResidue, pow_ne_zero m g_ne_zero, ↓reduceIte]
  rw [hx, hr, Option.getD_some]
  have h1 : b ^ (r % p) = b ^ (m % p) := by rw [← hob, pow_mod_orderOf, hbr, hob]
  exact pow_injOn_Iio_orderOf (x := b) (by simpa [hob] using Nat.mod_lt r hp)
    (by simpa [hob] using Nat.mod_lt m hp) h1

/-! ## The Chinese remainder theorem -/

theorem crtCombine_mod {m : ℕ} (hm : m < 2 ^ 64 - 1) :
    crtCombine (m % 3) (m % 5) (m % 17) (m % 257) (m % 641) (m % 65537) (m % 6700417) = m := by
  unfold crtCombine
  omega

/-! ## The discrete logarithm -/

/-- The stride inverts `s` baby steps. -/
theorem stride_mul {q p s : ℕ} {b c : K} (hb : b = g ^ q) (hc : c = b ^ (p - s)) (hsp : s ≤ p)
    (hqp : q * p = 2 ^ 64 - 1) : b ^ s * c = 1 := by
  rw [hc, ← pow_add, Nat.add_sub_cancel' hsp, hb, ← pow_mul, hqp, g_pow_card_sub_one]

theorem phResidue3 (m : ℕ) :
    phResidue 6148914691236517205 3 2 phBase3 phStride3 (g ^ m) = m % 3 := by
  have hb : phBase3 = g ^ 6148914691236517205 := by rw [phBase3_eq]; norm_num
  exact phResidue_gpow hb (by norm_num)
    (stride_mul hb phStride3_eq (by norm_num) (by norm_num)) (by norm_num) m

theorem phResidue5 (m : ℕ) :
    phResidue 3689348814741910323 5 3 phBase5 phStride5 (g ^ m) = m % 5 := by
  have hb : phBase5 = g ^ 3689348814741910323 := by rw [phBase5_eq]; norm_num
  exact phResidue_gpow hb (by norm_num)
    (stride_mul hb phStride5_eq (by norm_num) (by norm_num)) (by norm_num) m

theorem phResidue17 (m : ℕ) :
    phResidue 1085102592571150095 17 5 phBase17 phStride17 (g ^ m) = m % 17 := by
  have hb : phBase17 = g ^ 1085102592571150095 := by rw [phBase17_eq]; norm_num
  exact phResidue_gpow hb (by norm_num)
    (stride_mul hb phStride17_eq (by norm_num) (by norm_num)) (by norm_num) m

theorem phResidue257 (m : ℕ) :
    phResidue 71777214294589695 257 17 phBase257 phStride257 (g ^ m) = m % 257 := by
  have hb : phBase257 = g ^ 71777214294589695 := by rw [phBase257_eq]; norm_num
  exact phResidue_gpow hb (by norm_num)
    (stride_mul hb phStride257_eq (by norm_num) (by norm_num)) (by norm_num) m

theorem phResidue641 (m : ℕ) :
    phResidue 28778071877862015 641 26 phBase641 phStride641 (g ^ m) = m % 641 := by
  have hb : phBase641 = g ^ 28778071877862015 := by rw [phBase641_eq]; norm_num
  exact phResidue_gpow hb (by norm_num)
    (stride_mul hb phStride641_eq (by norm_num) (by norm_num)) (by norm_num) m

theorem phResidue65537 (m : ℕ) :
    phResidue 281470681808895 65537 257 phBase65537 phStride65537 (g ^ m) = m % 65537 := by
  have hb : phBase65537 = g ^ 281470681808895 := by rw [phBase65537_eq]; norm_num
  exact phResidue_gpow hb (by norm_num)
    (stride_mul hb phStride65537_eq (by norm_num) (by norm_num)) (by norm_num) m

theorem phResidue6700417 (m : ℕ) :
    phResidue 2753074036095 6700417 2589 phBase6700417 phStride6700417 (g ^ m) = m % 6700417 := by
  have hb : phBase6700417 = g ^ 2753074036095 := by rw [phBase6700417_eq]; norm_num
  exact phResidue_gpow hb (by norm_num)
    (stride_mul hb phStride6700417_eq (by norm_num) (by norm_num)) (by norm_num) m

/-- **`discreteLog` is the exponent below the order**: `discreteLog x = some n` exactly when
`g^n = x` and `n < 2^64 - 1`. -/
theorem discreteLog_eq_some_iff {x : K} {n : ℕ} :
    discreteLog x = some n ↔ g ^ n = x ∧ n < 2 ^ 64 - 1 := by
  constructor
  · intro h
    simp only [discreteLog, logCheck] at h
    split at h
    · exact absurd h (by simp)
    split at h
    · rename_i hx
      obtain rfl := Option.some.inj h
      exact ⟨hx, by unfold phCandidate crtCombine; omega⟩
    · exact absurd h (by simp)
  · rintro ⟨rfl, hn⟩
    simp only [discreteLog, pow_ne_zero n g_ne_zero, phCandidate, phResidue3, phResidue5,
      phResidue17, phResidue257, phResidue641, phResidue65537, phResidue6700417, crtCombine_mod hn,
      logCheck, ↓reduceIte]

/-- **The interface the decoder needs** (`DiscreteLogSpec`): for every `x` and `n`,
`discreteLog x = some n ↔ gpow n = x ∧ n < 2^64 - 1`. -/
theorem discreteLog_spec :
    ∀ x n, discreteLog x = some n ↔ gpow n = x ∧ n < 2 ^ 64 - 1 :=
  fun _ _ ↦ discreteLog_eq_some_iff

/-- **Soundness**: what `discreteLog` returns is an exponent of `x` below the order. -/
theorem discreteLog_sound {x : K} {n : ℕ} (h : discreteLog x = some n) :
    g ^ n = x ∧ n < 2 ^ 64 - 1 :=
  discreteLog_eq_some_iff.1 h

/-- **Completeness**: an exponent of `x` below the order is what `discreteLog` returns. -/
theorem discreteLog_complete {x : K} {n : ℕ} (hx : g ^ n = x) (hn : n < 2 ^ 64 - 1) :
    discreteLog x = some n :=
  discreteLog_eq_some_iff.2 ⟨hx, hn⟩

/-- The logarithm of a power: its exponent modulo the order. -/
theorem discreteLog_gpow (n : ℕ) : discreteLog (g ^ n) = some (n % (2 ^ 64 - 1)) :=
  discreteLog_complete (by rw [← orderOf_g, pow_mod_orderOf]) (Nat.mod_lt _ (by norm_num))

/-- `0` has no logarithm. -/
theorem discreteLog_zero : discreteLog 0 = none := by
  cases h : discreteLog 0 with
  | none => rfl
  | some n => exact absurd (discreteLog_sound h).1 (pow_ne_zero n g_ne_zero)

end

end LeanVM.Extraction.Fast
