/-
  LeanVM.Parameters.PohligHellman

  The constants of the discrete logarithm in `K^×` (`Fast/DiscreteLog.lean`): for each prime
  factor `p` of `2^64 - 1`, the element `g^((2^64-1)/p)` of order `p` and its baby-step-giant-step
  stride, as literals, kernel-checked.
-/

module

public import Statement.Field

/-!
# The Pohlig–Hellman constants

`|K^×| = 2^64 - 1 = 3·5·17·257·641·65537·6700417` and `g` generates `K^×` (`orderOf_g`). The
discrete logarithm (`LeanVM.Extraction.Fast.discreteLog`) reads the exponent modulo each prime
`p` off `x^((2^64-1)/p)` in the subgroup of order `p`, generated by `phBase p = g^((2^64-1)/p)`,
by baby steps `phBase p ^ j`, `j < s`, and giant steps by `phStride p = phBase p ^ (p - s)`, the
inverse of `phBase p ^ s` (`s = ⌈√p⌉`: `2, 3, 5, 17, 26, 257, 2589`).

The fourteen words are literals, so a run computes none of them; each is checked here by a
`decide +kernel` (an exponentiation by squaring of a 64-bit exponent). This module imports only
the field: `PohligHellmanFirewall.lean` fails to build if that changes.
-/

namespace LeanVM.Parameters

@[expose] public section

/-- `g^((2^64-1)/3)`, of order `3`. -/
def phBase3 : K := K.ofBits 0x19c9369f278adc02
/-- `g^((2^64-1)/5)`, of order `5`. -/
def phBase5 : K := K.ofBits 0x5db84357ce785d09
/-- `g^((2^64-1)/17)`, of order `17`. -/
def phBase17 : K := K.ofBits 0x0cf7b828f270c0db
/-- `g^((2^64-1)/257)`, of order `257`. -/
def phBase257 : K := K.ofBits 0x56dfcf872019d0c1
/-- `g^((2^64-1)/641)`, of order `641`. -/
def phBase641 : K := K.ofBits 0x6bf808f7824282a2
/-- `g^((2^64-1)/65537)`, of order `65537`. -/
def phBase65537 : K := K.ofBits 0x1c1e79669b95a7ce
/-- `g^((2^64-1)/6700417)`, of order `6700417`. -/
def phBase6700417 : K := K.ofBits 0x00f542601703f991

/-- `phBase3 ^ (3 - 2)`, the inverse of `phBase3 ^ 2`. -/
def phStride3 : K := K.ofBits 0x19c9369f278adc02
/-- `phBase5 ^ (5 - 3)`, the inverse of `phBase5 ^ 3`. -/
def phStride5 : K := K.ofBits 0xfc39a481a127aa9d
/-- `phBase17 ^ (17 - 5)`, the inverse of `phBase17 ^ 5`. -/
def phStride17 : K := K.ofBits 0x0c9e636090aafc01
/-- `phBase257 ^ (257 - 17)`, the inverse of `phBase257 ^ 17`. -/
def phStride257 : K := K.ofBits 0x10da9ebd33d00258
/-- `phBase641 ^ (641 - 26)`, the inverse of `phBase641 ^ 26`. -/
def phStride641 : K := K.ofBits 0xe571e787f8bc7418
/-- `phBase65537 ^ (65537 - 257)`, the inverse of `phBase65537 ^ 257`. -/
def phStride65537 : K := K.ofBits 0xb48c638f3ea0d847
/-- `phBase6700417 ^ (6700417 - 2589)`, the inverse of `phBase6700417 ^ 2589`. -/
def phStride6700417 : K := K.ofBits 0x1a791c8fed2147fa

theorem phBase3_eq : phBase3 = g ^ ((2 ^ 64 - 1) / 3) := by decide +kernel
theorem phBase5_eq : phBase5 = g ^ ((2 ^ 64 - 1) / 5) := by decide +kernel
theorem phBase17_eq : phBase17 = g ^ ((2 ^ 64 - 1) / 17) := by decide +kernel
theorem phBase257_eq : phBase257 = g ^ ((2 ^ 64 - 1) / 257) := by decide +kernel
theorem phBase641_eq : phBase641 = g ^ ((2 ^ 64 - 1) / 641) := by decide +kernel
theorem phBase65537_eq : phBase65537 = g ^ ((2 ^ 64 - 1) / 65537) := by decide +kernel
theorem phBase6700417_eq : phBase6700417 = g ^ ((2 ^ 64 - 1) / 6700417) := by decide +kernel

theorem phStride3_eq : phStride3 = phBase3 ^ (3 - 2) := by decide +kernel
theorem phStride5_eq : phStride5 = phBase5 ^ (5 - 3) := by decide +kernel
theorem phStride17_eq : phStride17 = phBase17 ^ (17 - 5) := by decide +kernel
theorem phStride257_eq : phStride257 = phBase257 ^ (257 - 17) := by decide +kernel
theorem phStride641_eq : phStride641 = phBase641 ^ (641 - 26) := by decide +kernel
theorem phStride65537_eq : phStride65537 = phBase65537 ^ (65537 - 257) := by decide +kernel
theorem phStride6700417_eq : phStride6700417 = phBase6700417 ^ (6700417 - 2589) := by
  decide +kernel

end

end LeanVM.Parameters
