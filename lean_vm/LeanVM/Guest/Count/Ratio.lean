    t.name = "claim_list_digest" → t.Valid coreProgram rd args rets → t.BufsOk coreProgram →
      1000 * t.weight (ωArm xmssArmC op) ≤ krClA op * t.total fs :=
  fun _ _ _ _ hn hv _ => kr_weight krCl_closed krCl_ratio (by decide +kernel)
    ⟨23, by decide +kernel, by decide +kernel⟩ op hn hv

