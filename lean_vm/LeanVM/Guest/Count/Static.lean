    simp only [kcAggC, kcAggD]; omega
  · have := kwm_weight_le_of_stat (by rw [kwmcertOf_of_idx (j := 31) (by decide +kernel)]; rfl : kwmcertOf "aggregate_claims" = .stat [(0, 0)] ⟨172, [(0, 77), (0, 26), (0, 63)]⟩ [(.n 63, 0), (.n 96, 0), (.n 122, 0)]) hn hv hb hpre
