/-!
# `main`'s static callees' counts and words

From the certificates counting each opcode's instructions (`Memory/GuestCnt*`): constants for
`exponent_tables`, `da_list_digest`, `cover_da_root` and `statement_digest`, per iteration for the
loops `__loop0`..`__loop4` and `__loop28` (each child's DA roots in `__loop5`) from `g^a` to `g^e`
(`e - a` iterations, `LoopWeightLe`), and affine in `n` for `aggregate_claims` on `g^n`
(`kcAgg_le`). From the certificates counting words (`Memory/GuestWords`), at `B2C.fs`: the
constants' `TotalLe` and the loops' words per iteration (`LoopTotalLe`, and `TotalLeOn` from a
start below the end, `LoopTotalLe.totalLeOn`).

`claim_list_digest`, `child_claim_list_digest`, `da_verify`, `verify_sub` and `__loop5` have no
static bound (their loops end at hinted values), nor `aggregate_claims` a words certificate (its
`HeapBuf` sizes are powers of its argument).
-/

namespace LeanVM.Guest.Count

open LeanVM.Parameters LeanVM.Semantics LeanVM.Guest.Core LeanVM.Guest.Memory LeanVM.Guest

@[expose] public section

/-- **A loop helper from `g^a` to `g^e` weighs at most `K` per iteration**, on every valid tree. -/
def LoopWeightLe (ω : String → ℕ) (f : String) (K : ℕ) : Prop :=
  ∀ (rd : Reader) (t : Tree) (args rets : List E) (a e : ℕ), t.name = f →
    t.Valid coreProgram rd args rets → t.BufsOk coreProgram → args.getD 0 0 = ofK (gpow a) →
    args.getD 1 0 = ofK (gpow e) → a < e → e < 2 ^ 64 - 1 → t.weight ω ≤ (e - a) * K

/-- **A loop helper from `g^a` to `g^e` allocates at most `K` words per iteration**, on every
valid tree. -/
def LoopTotalLe (fs : String → ℕ) (f : String) (K : ℕ) : Prop :=
  ∀ (rd : Reader) (t : Tree) (args rets : List E) (a e : ℕ), t.name = f →
    t.Valid coreProgram rd args rets → t.BufsOk coreProgram → args.getD 0 0 = ofK (gpow a) →
    args.getD 1 0 = ofK (gpow e) → a < e → e < 2 ^ 64 - 1 → t.total fs ≤ (e - a) * K

/-- A loop's words from a start below its end: at most `K` per unit of the end's exponent. -/
theorem LoopTotalLe.totalLeOn {fs : String → ℕ} {f : String} {K : ℕ} (h : LoopTotalLe fs f K) :
    TotalLeOn coreProgram fs f LoopPre fun a => logG (a.getD 1 0) * K := by
  intro rd t args rets hn ⟨a, e, ha, he, hae, heo⟩ hv hb
  have := h rd t args rets a e hn hv hb ha he hae heo
  dsimp only
  rw [he, logG_spec heo]
  exact this.trans (Nat.mul_le_mul_right _ (Nat.sub_le _ _))

/-! ## Any certified function, by its certificate -/

/-- The certificates counting `op`'s instructions (`Memory/GuestCnt*`). -/
noncomputable def kcCert : Opcode → String → Cert
  | .xor => kwxcertOf
  | .mulNative => kwmcertOf
  | .setConstant => kwscertOf
  | .deref => kwdcertOf
  | .jump => kwjcertOf
  | .keccak => kwkcertOf

/-- **The certificates counting `op`'s instructions check** at `B2C.ωArm B2C.xmssArmC op`. -/
theorem kc_checked (op : Opcode) :
    Checked coreProgram false (kcCert op) (B2C.ωArm B2C.xmssArmC op) := by
  cases op
  · exact kwx_checked
  · exact kwm_checked
  · exact kws_checked
  · exact kwd_checked
  · exact kwj_checked
  · exact kwk_checked

/-- A function with a constant certificate counting `op`'s instructions (read it by
`kw<p>certOf_of_idx` and `rfl`). -/
theorem kc_weightLe_of {op : Opcode} {f : String} {B : ℕ} {ks : List (V × ℕ)}
    (hcf : kcCert op f = .stat [] ⟨B, []⟩ ks) :
    WeightLe coreProgram (B2C.ωArm B2C.xmssArmC op) f fun _ => B :=
  weightLe_of_stat (kc_checked op) hcf

/-- A loop helper ending at its argument `1`, with a constant certificate per iteration counting
`op`'s instructions. -/
theorem kc_loopWeightLe_of {op : Opcode} {f : String} {K : ℕ} {ks : List (V × ℕ)}
    (hcf : kcCert op f = .loop none [] ⟨K, []⟩ ks) :
    LoopWeightLe (B2C.ωArm B2C.xmssArmC op) f K := by
  intro rd t args rets a e hn hv hb ha he hae heo
  have := weight_le_of_loop (kc_checked op) hcf hn hv hb ha he hae heo
    (fun _ h => (List.not_mem_nil h).elim)
  simpa [Aff.eval] using this

/-- A loop helper ending at its argument `1`, with a constant certificate per iteration counting
words. -/
theorem kw_loopTotalLe_of {f : String} {K : ℕ} {ks : List (V × ℕ)}
    (hcf : wcertOf f = .loop none [] ⟨K, []⟩ ks) : LoopTotalLe B2C.fs f K := by
  intro rd t args rets a e hn hv hb ha he hae heo
  have := fs_total_le_of_loop hcf hn hv hb ha he hae heo (fun _ h => (List.not_mem_nil h).elim)
  simpa [Aff.eval] using this

