  b : Nat
  f0 : Nat
  p00 : Nat
  p01 : Nat
  s1 : Nat
  f1 : Nat
  p10 : Nat
  p11 : Nat
  top : Nat
  q0 : Nat
  q1 : Nat
  deriving DecidableEq

