/-- The functions the certificates counting instructions cover, by core index (each its own
value): the closure of `verify_sub`'s statically bounded callees. -/
def kcvST : NTree ℕ := (.node 584 584 (.node 438 438 (.node 352 352 kcvSTlll kcvSTllr) (.node 511 511 kcvSTlrl kcvSTlrr)) (.node 730 730 (.node 657 657 kcvSTrll kcvSTrlr) (.node 805 805 kcvSTrrl kcvSTrrr)))

/-- Function `j` is covered. -/
def kcvIn (j : ℕ) : Prop := kcvST.find j = some j

instance (j : ℕ) : Decidable (kcvIn j) := inferInstanceAs (Decidable (_ = _))

/-- `B2C.xmssArmC` at function `j`, by `Opcode`'s index. -/
def kcvArmJ (j i : ℕ) : ℕ := if j = 19 then [40, 80, 40, 0, 40, 348].getD i 0 else 0

theorem kcv_name_xmss {j : ℕ} (hj : j < coreProgram.length) :
    coreProgram[j].name = "verify_lean_xmss" ↔ j = 19 := by
  have hx : (coreProgram[19]?).map Fn.name = some "verify_lean_xmss" := by decide +kernel
  constructor
  · intro h
    have := coreIdx_getElem hj
    rw [h, coreIdx_of_name hx] at this
    exact this.symm
  · rintro rfl
    rw [List.getElem?_eq_getElem hj] at hx
    simpa using hx

/-- The families' frame weights at function `j` are its `pathMax` and arms. -/
noncomputable def kcvPmAt (j : ℕ) : Bool :=
  kvxomegaJ j == (B2C.plumbOf (j + 1)).pmax.getD 0 0 + kcvArmJ j 0 &&
    kvmomegaJ j == (B2C.plumbOf (j + 1)).pmax.getD 1 0 + kcvArmJ j 1 &&
    kvsomegaJ j == (B2C.plumbOf (j + 1)).pmax.getD 2 0 + kcvArmJ j 2 &&
    kvdomegaJ j == (B2C.plumbOf (j + 1)).pmax.getD 3 0 + kcvArmJ j 3 &&
    kvjomegaJ j == (B2C.plumbOf (j + 1)).pmax.getD 4 0 + kcvArmJ j 4 &&
    kvkomegaJ j == (B2C.plumbOf (j + 1)).pmax.getD 5 0 + kcvArmJ j 5

theorem kcvPm_all : kcvST.all kcvPmAt = true := by decide +kernel

theorem kcvPm_eq {j : ℕ} (hS : kcvIn j) :
    kvxomegaJ j = (B2C.plumbOf (j + 1)).pmax.getD 0 0 + kcvArmJ j 0 ∧
      kvmomegaJ j = (B2C.plumbOf (j + 1)).pmax.getD 1 0 + kcvArmJ j 1 ∧
      kvsomegaJ j = (B2C.plumbOf (j + 1)).pmax.getD 2 0 + kcvArmJ j 2 ∧
      kvdomegaJ j = (B2C.plumbOf (j + 1)).pmax.getD 3 0 + kcvArmJ j 3 ∧
      kvjomegaJ j = (B2C.plumbOf (j + 1)).pmax.getD 4 0 + kcvArmJ j 4 ∧
      kvkomegaJ j = (B2C.plumbOf (j + 1)).pmax.getD 5 0 + kcvArmJ j 5 := by
  have h := NTree.find_all kcvPm_all hS
  simp only [kcvPmAt, Bool.and_eq_true, beq_iff_eq] at h
  obtain ⟨⟨⟨⟨⟨h0, h1⟩, h2⟩, h3⟩, h4⟩, h5⟩ := h
  exact ⟨h0, h1, h2, h3, h4, h5⟩

theorem kcv_idxOf {j : ℕ} (hj : j < coreProgram.length) :
    B2C.idxOf coreProgram[j].name = some (j + 1) := by
  unfold B2C.idxOf
  rw [coreProgram_indexOf?_getElem hj]
  rfl

/-- `kcvArmJ` is `B2C.xmssArmC` at `verify_lean_xmss`. -/
theorem kcvArmJ_eq {j : ℕ} (hj : j < coreProgram.length) (op : Opcode) :
    kcvArmJ j (B2C.opIdx op) = if coreProgram[j].name = "verify_lean_xmss" then B2C.xmssArmC op else 0 := by
  by_cases hx : j = 19
  · subst hx
    have hn := (kcv_name_xmss hj).mpr rfl
    simp only [hn, ↓reduceIte]
    cases op <;> rfl
  · have hn : ¬ coreProgram[j].name = "verify_lean_xmss" := fun h => hx ((kcv_name_xmss hj).mp h)
    simp [kcvArmJ, hx, hn]

