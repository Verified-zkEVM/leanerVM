/-- Evaluation `k`'s value. -/
def vtEvB (k : ℕ) : ℕ := (vtEvalData.getD k (0, 0, 0)).2.1

/-- An evaluation's statements. -/
def vtEvalT (b off tau : ℕ) : List Stmt :=
  fsNextT (.n 5932) off b ++ [.atom (.copy (.n (b + 10)) (.n b)),
    .atom (.load (.n b) (.n 16) (5 + off)), .atom (.load (.n tau) (.n 17) (5 + off))]

/-- The capacity cells before permutation `j`. -/
def vtPermCap (j : ℕ) : List V :=
  if j = 0 then (List.range 5).map fun k ↦ .n (5927 + k)
  else lyCap (vtPermData.getD (j - 1) (0, 0)).2

/-- Permutation `j`'s statement. -/
def vtPermT (j : ℕ) : Stmt :=
  keccakA (((List.range 4).flatMap fun i ↦ [V.n (vtEvB (4 * j + i) + 7), .n (vtEvB (4 * j + i) + 9)]) ++
    vtPermCap j) (lyOuts (vtPermData.getD j (0, 0)).2)

theorem vtEval_check : ∀ k < 157,
    tbStmtsEqb (vtEvalT (vtEvalData.getD k (0, 0, 0)).2.1 k (vtEvalData.getD k (0, 0, 0)).2.2)
      ((vtPre.drop (vtEvalData.getD k (0, 0, 0)).1).take
        (vtEvalT (vtEvalData.getD k (0, 0, 0)).2.1 k (vtEvalData.getD k (0, 0, 0)).2.2).length) =
      true := by
  decide +kernel

theorem vtPerm_check : ∀ j < 39,
    tbStmtsEqb [vtPermT j] ((vtPre.drop (vtPermData.getD j (0, 0)).1).take 1) = true := by
  decide +kernel

